# ============================================================
# TOKEN EXTRACTION
# ============================================================
def _flatten(d, prefix=""):
    out = {}
    if isinstance(d, dict):
        for k, v in d.items():
            key = f"{prefix}.{k}" if prefix else k
            if isinstance(v, (dict, list)):
                out.update(_flatten(v, key))
            else:
                out[key.lower()] = v
    elif isinstance(d, list):
        for i, v in enumerate(d):
            out.update(_flatten(v, f"{prefix}[{i}]"))
    return out


def extract_tokens(obj: Dict) -> Optional[Dict]:
    if not isinstance(obj, dict):
        return None
    flat = _flatten(obj)
    token = None
    m_id = None
    vid = None

    for k, v in flat.items():
        if isinstance(v, str) and v.startswith("eyJ") and len(v) > 80:
            if any(t in k for t in ("token", "auth", "jwt")):
                token = v
                break
    if not token:
        for k, v in flat.items():
            if isinstance(v, str) and v.startswith("eyJ") and len(v) > 80:
                token = v
                break

    for key in ("mid", "m_id", "memberid", "member_id", "bb_mid"):
        for fk, v in flat.items():
            if fk == key or fk.endswith("." + key) or key in fk:
                if isinstance(v, str) and v:
                    m_id = v
                    break
        if m_id:
            break

    for key in ("bbvisitorid", "bb_visitor_id", "visitorid",
                "visitor_id", "vid", "bb_vid"):
        for fk, v in flat.items():
            if fk == key or fk.endswith("." + key) or key in fk:
                if isinstance(v, str) and v:
                    vid = v
                    break
        if vid:
            break

    if not token:
        return None
    return {"bbAuthToken": token, "mId": m_id, "bbVisitorId": vid}


def extract_tokens_from_text(text: str) -> Optional[Dict]:
    jwt_m = re.search(
        r"(eyJ[a-zA-Z0-9_\-]+\.[a-zA-Z0-9_\-]+\.[a-zA-Z0-9_\-]+)",
        text
    )
    if not jwt_m:
        return None

    def _find(keys):
        for k in keys:
            m = re.search(rf'"{k}"\s*:\s*"([^"]+)"', text, re.IGNORECASE)
            if m:
                return m.group(1)
        return None

    return {
        "bbAuthToken": jwt_m.group(1),
        "mId": _find(["mId", "m_id", "member_id", "memberId"]),
        "bbVisitorId": _find(["bbVisitorId", "bb_visitor_id",
                              "visitor_id", "visitorId", "vid"]),
    }


