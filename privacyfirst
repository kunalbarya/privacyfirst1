def format_summary(results: List[Dict], elapsed: float, fname: str) -> str:
    cash = [r for r in results if r.get("has_cash")]
    failed = [r for r in results if r.get("error") == "auth_failed"]
    tw = sum(r.get("wallet", 0) for r in results)
    tf = sum(r.get("freecash", 0) for r in results)
    grand = tw + tf

    return (
        f"📊 <b>BigBasket Check Complete</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━━━\n"
        f"📁 File: <code>{fname}</code>\n\n"
        f"🔢 Total checked: <b>{len(results)}</b>\n"
        f"💰 With cash: <b>{len(cash)}</b>\n"
        f"🔒 Auth failed: <b>{len(failed)}</b>\n\n"
        f"💳 Wallet total: <b>₹{tw:.2f}</b>\n"
        f"🎯 FreeCash total: <b>₹{tf:.2f}</b>\n"
        f"━━━━━━━━━━━━━━━━━━━━━━\n"
        f"🏆 <b>Grand Total: ₹{grand:.2f}</b>\n\n"
        f"⏱️ Elapsed: {elapsed:.1f}s"
    )


def format_cash_accounts(results: List[Dict], limit: int = 40) -> str:
    cash = [r for r in results if r.get("has_cash")]
    if not cash:
        return "💸 <b>No accounts with balance found.</b>"

    cash.sort(key=lambda r: r.get("total", 0), reverse=True)
    shown = cash[:limit]

    lines = [f"💰 <b>Accounts with Cash ({len(cash)})</b>", ""]
    for i, r in enumerate(shown, 1):
        mid = r.get("mId") or "N/A"
        w = r.get("wallet", 0)
        f = r.get("freecash", 0)
        t = r.get("total", 0)
        lines.append(
            f"<b>{i}.</b> <code>{mid}</code>\n"
            f"    💳 ₹{w:.2f}  |  🎯 ₹{f:.2f}  |  Σ ₹{t:.2f}"
        )
    if len(cash) > limit:
        lines.append(f"\n… and {len(cash) - limit} more (see attached file)")
    return "\n".join(lines)


def chunk_message(text: str, max_len: int = 3800) -> List[str]:
    chunks = []
    while len(text) > max_len:
        cut = text.rfind("\n", 0, max_len)
        if cut == -1:
            cut = max_len
        chunks.append(text[:cut])
        text = text[cut:].lstrip("\n")
    if text:
        chunks.append(text)
    return chunks


