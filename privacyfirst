def check_account(tokens: Dict, source: str = "input") -> Dict:
    bb_token = tokens.get("bbAuthToken")
    m_id_raw = tokens.get("mId")
    vid_raw = tokens.get("bbVisitorId")

    result = {
        "source": source,
        "mId": m_id_raw,
        "bbVisitorId": vid_raw,
        "bbAuthToken": bb_token,
        "wallet": 0.0,
        "freecash": 0.0,
        "total": 0.0,
        "has_cash": False,
        "wallet_ok": False,
        "freecash_ok": False,
        "error": None,
    }

    try:
        client = BigBasketClient(
            silent=True,
            bb_auth_token=bb_token,
            m_id=m_id_raw,
            bb_visitor_id=vid_raw,
        )
        result["mId"] = client.m_id
        result["bbVisitorId"] = client.visitor_id

        wallet_data = client.get_wallet_details()
        if wallet_data:
            result["wallet_ok"] = True
            try:
                result["wallet"] = float(wallet_data.get("current_wallet_balance") or 0)
            except (TypeError, ValueError):
                result["wallet"] = 0.0

        freecash_data = client.get_free_cash()
        if freecash_data:
            result["freecash_ok"] = True
            try:
                result["freecash"] = float(freecash_data.get("total_freecash_amount") or 0)
            except (TypeError, ValueError):
                result["freecash"] = 0.0

        result["total"] = round(result["wallet"] + result["freecash"], 2)
        result["has_cash"] = result["total"] > 0

        if not result["wallet_ok"] and not result["freecash_ok"]:
            result["error"] = "auth_failed"

    except Exception as e:
        result["error"] = str(e)

    return result


# ============================================================
# FILE PARSING
# ============================================================
def _safe_text(raw: bytes) -> str:
    for enc in ("utf-8", "utf-16", "latin-1"):
        try:
            return raw.decode(enc)
        except Exception:
            continue
    return raw.decode("utf-8", errors="ignore")


def parse_uploaded_file(filename: str, data: bytes) -> List[Dict]:
    """Return list of token dicts from an uploaded file."""
    lower = filename.lower()
    tokens_list: List[Dict] = []

    # --- ZIP ---
    if lower.endswith(".zip"):
        try:
            with zipfile.ZipFile(io.BytesIO(data)) as zf:
                json_names = [n for n in zf.namelist() if n.lower().endswith(".json")]
                txt_names = [n for n in zf.namelist() if n.lower().endswith(".txt")]
                names = json_names or txt_names or zf.namelist()

                for n in names:
                    try:
                        raw = zf.read(n)
                    except Exception:
                        continue
                    text = _safe_text(raw)
                    tokens_list.extend(_tokens_from_blob(text))

        except Exception as e:
            print(f"ZIP parse error: {e}")

    # --- JSON ---
    elif lower.endswith(".json"):
        text = _safe_text(data)
        try:
            obj = json.loads(text)
            if isinstance(obj, list):
                for item in obj:
                    t = extract_tokens(item)
                    if t:
                        tokens_list.append(t)
            elif isinstance(obj, dict):
                t = extract_tokens(obj)
                if t:
                    tokens_list.append(t)
        except json.JSONDecodeError:
            tokens_list.extend(_tokens_from_blob(text))

    # --- TXT / anything ---
    else:
        text = _safe_text(data)
        tokens_list.extend(_tokens_from_blob(text))

    # Dedup by JWT
    seen = set()
    unique = []
    for t in tokens_list:
        key = (t.get("bbAuthToken") or "")[:80]
        if key and key not in seen:
            seen.add(key)
            unique.append(t)
    return unique


def _tokens_from_blob(text: str) -> List[Dict]:
    """Extract tokens from arbitrary text/JSONL/regex fallback."""
    found = []

    # Whole-blob JSON
    try:
        obj = json.loads(text)
        if isinstance(obj, list):
            for item in obj:
                t = extract_tokens(item)
                if t:
                    found.append(t)
            return found
        if isinstance(obj, dict):
            t = extract_tokens(obj)
            if t:
                found.append(t)
            return found
    except Exception:
        pass

    # JSONL — one JSON per line
    for line in text.splitlines():
        line = line.strip()
        if not line or line[0] not in "{[":
            continue
        try:
            obj = json.loads(line)
            t = extract_tokens(obj)
            if t:
                found.append(t)
        except Exception:
            continue

    if found:
        return found

    # Regex fallback — every JWT + nearby mId/vid
    jwt_re = re.compile(r"(eyJ[a-zA-Z0-9_\-]+\.[a-zA-Z0-9_\-]+\.[a-zA-Z0-9_\-]+)")
    mid_re = re.compile(r'"mId"\s*:\s*"([^"]+)"', re.IGNORECASE)
    vid_re = re.compile(
        r'"(?:bbVisitorId|bb_visitor_id|visitor_id|visitorId|vid)"\s*:\s*"([^"]+)"',
        re.IGNORECASE
    )

    for jw in jwt_re.finditer(text):
        token = jw.group(1)
        window = text[max(0, jw.start() - 500): jw.end() + 500]
        mid_m = mid_re.search(window)
        vid_m = vid_re.search(window)
        found.append({
            "bbAuthToken": token,
            "mId": mid_m.group(1) if mid_m else None,
            "bbVisitorId": vid_m.group(1) if vid_m else None,
        })
    return found


