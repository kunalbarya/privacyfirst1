async def handle_document(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    msg = update.message
    doc = msg.document
    user = update.effective_user

    # Size guard
    if doc.file_size and doc.file_size > MAX_FILE_SIZE_MB * 1024 * 1024:
        await msg.reply_text(f"❌ File too large (max {MAX_FILE_SIZE_MB} MB)")
        return

    fname = doc.file_name or "upload.bin"
    print(f"[TG] User {user.id} ({user.username}) uploaded {fname} ({doc.file_size} bytes)")

    status = await msg.reply_text(
        f"📥 Downloading <code>{fname}</code>…",
        parse_mode=ParseMode.HTML
    )
    await ctx.bot.send_chat_action(chat_id=msg.chat_id, action=ChatAction.TYPING)

    # Download
    try:
        tg_file = await doc.get_file()
        buf = io.BytesIO()
        await tg_file.download_to_memory(buf)
        raw = buf.getvalue()
    except Exception as e:
        await status.edit_text(f"❌ Download failed: {e}")
        return

    await status.edit_text("🔍 Parsing accounts…")

    # Parse
    try:
        tokens_list = parse_uploaded_file(fname, raw)
    except Exception as e:
        await status.edit_text(f"❌ Parse error: {e}")
        return

    if not tokens_list:
        await status.edit_text(
            "❌ No valid BigBasket accounts found in file.\n"
            "Make sure it contains <code>bbAuthToken</code> (a JWT starting with <code>eyJ</code>).",
            parse_mode=ParseMode.HTML,
        )
        return

    if len(tokens_list) > MAX_ACCOUNTS_PER_JOB:
        tokens_list = tokens_list[:MAX_ACCOUNTS_PER_JOB]
        await msg.reply_text(f"⚠️ Limiting to first {MAX_ACCOUNTS_PER_JOB} accounts.")

    total = len(tokens_list)
    await status.edit_text(
        f"✅ Found <b>{total}</b> account(s). Checking…\n"
        f"<i>This may take a few minutes.</i>",
        parse_mode=ParseMode.HTML,
    )

    results: List[Dict] = []
    t0 = time.time()
    last_edit = 0.0

    for i, tokens in enumerate(tokens_list, 1):
        source = f"acct{i}"
        result = await asyncio.to_thread(check_account, tokens, source)
        results.append(result)

        now = time.time()
        if now - last_edit > 2.5 or i == total:
            last_edit = now
            cash_so_far = sum(1 for r in results if r.get("has_cash"))
            try:
                await status.edit_text(
                    f"⏳ Progress: <b>{i}/{total}</b>\n"
                    f"💰 With cash so far: <b>{cash_so_far}</b>",
                    parse_mode=ParseMode.HTML,
                )
            except Exception:
                pass

        await asyncio.sleep(0.3)

    elapsed = time.time() - t0

    # Summary
    try:
        await status.edit_text(
            format_summary(results, elapsed, fname),
            parse_mode=ParseMode.HTML,
        )
    except Exception:
        pass

    # Cash accounts
    cash_text = format_cash_accounts(results, limit=40)
    for chunk in chunk_message(cash_text, 3800):
        try:
            await msg.reply_text(chunk, parse_mode=ParseMode.HTML)
        except Exception:
            await msg.reply_text(chunk)

    # Full results JSON file
    payload = {
        "summary": {
            "total": len(results),
            "with_cash": sum(1 for r in results if r.get("has_cash")),
            "auth_failed": sum(1 for r in results if r.get("error") == "auth_failed"),
            "total_wallet": round(sum(r.get("wallet", 0) for r in results), 2),
            "total_freecash": round(sum(r.get("freecash", 0) for r in results), 2),
            "grand_total": round(sum(r.get("total", 0) for r in results), 2),
            "elapsed": round(elapsed, 1),
            "checked_at": datetime.utcnow().isoformat() + "Z",
            "source_file": fname,
            "user_id": user.id,
        },
        "cash_accounts": [r for r in results if r.get("has_cash")],
        "all_results": results,
    }

    out_name = f"{os.path.splitext(fname)[0]}_checked_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
    out_path = os.path.join(RESULTS_DIR, out_name)
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2, ensure_ascii=False)

    with open(out_path, "rb") as f:
        await msg.reply_document(
            document=f,
            filename=out_name,
            caption=f"📎 Full results ({len(results)} accounts)",
        )

    print(f"[TG] User {user.id}: done {len(results)}, {payload['summary']['with_cash']} with cash")


async def handle_text(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    """Allow pasting tokens directly as chat text."""
    text = (update.message.text or "").strip()
    if not text or text.startswith("/"):
        return

    if "eyJ" not in text:
        await update.message.reply_text(
            "Send a <b>.zip</b>, <b>.json</b>, or <b>.txt</b> file with accounts, "
            "or paste tokens directly (must contain a JWT starting with <code>eyJ</code>).",
            parse_mode=ParseMode.HTML,
        )
        return

    tokens_list = _tokens_from_blob(text)
    if not tokens_list:
        await update.message.reply_text("❌ Could not find any BigBasket tokens in that text.")
        return

    if len(tokens_list) > MAX_ACCOUNTS_PER_JOB:
        tokens_list = tokens_list[:MAX_ACCOUNTS_PER_JOB]

    status = await update.message.reply_text(
        f"✅ Found <b>{len(tokens_list)}</b> account(s). Checking…",
        parse_mode=ParseMode.HTML,
    )

    results: List[Dict] = []
    t0 = time.time()
    for i, tokens in enumerate(tokens_list, 1):
        r = await asyncio.to_thread(check_account, tokens, f"acct{i}")
        results.append(r)
        if i % 3 == 0 or i == len(tokens_list):
            try:
                await status.edit_text(
                    f"⏳ Progress: <b>{i}/{len(tokens_list)}</b>",
                    parse_mode=ParseMode.HTML,
                )
            except Exception:
                pass
        await asyncio.sleep(0.3)

    elapsed = time.time() - t0
    try:
        await status.edit_text(
            format_summary(results, elapsed, "pasted_text"),
            parse_mode=ParseMode.HTML,
        )
    except Exception:
        pass

    cash_text = format_cash_accounts(results, limit=40)
    for chunk in chunk_message(cash_text, 3800):
        try:
            await update.message.reply_text(chunk, parse_mode=ParseMode.HTML)
        except Exception:
            await update.message.reply_text(chunk)


async def cmd_stats(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    files = [f for f in os.listdir(RESULTS_DIR) if f.endswith(".json")]
    await update.message.reply_text(
        f"📁 Results saved: <b>{len(files)}</b> file(s) in <code>{RESULTS_DIR}/</code>",
        parse_mode=ParseMode.HTML,
    )


