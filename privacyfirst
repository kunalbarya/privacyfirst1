def main():
    if not BOT_TOKEN:
        print("ERROR: Set TG_BOT_TOKEN environment variable.")
        print('  Windows PowerShell:')
        print('    $env:TG_BOT_TOKEN = "123456:ABC-xyz..."')
        print('  Or edit BOT_TOKEN directly in this file.')
        sys.exit(1)

    print("=" * 60)
    print("  BigBasket Telegram Bot")
    print("=" * 60)
    print(f"  Max file size: {MAX_FILE_SIZE_MB} MB")
    print(f"  Max accounts/job: {MAX_ACCOUNTS_PER_JOB}")
    print(f"  Results dir: {RESULTS_DIR}/")
    print("  Press Ctrl+C to stop")
    print("=" * 60)

    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("help", cmd_help))
    app.add_handler(CommandHandler("id", cmd_id))
    app.add_handler(CommandHandler("stats", cmd_stats))
    app.add_handler(MessageHandler(filters.Document.ALL, handle_document))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))

    app.run_polling(allowed_updates=Update.ALL_TYPES, drop_pending_updates=True)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nBot stopped.")
    except Exception as e:
        print(f"Fatal: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
