    def _hydrate_from_tokens(self, bb_auth_token, m_id, bb_visitor_id):
        def _maybe_decode(v):
            if not v or not isinstance(v, str) or len(v) < 4:
                return v
            try:
                padded = v + "=" * ((4 - len(v) % 4) % 4)
                dec = base64.b64decode(padded).decode("utf-8")
                if dec and all(c.isdigit() or c.isalpha() or c in "-_." for c in dec):
                    return dec
            except Exception:
                pass
            return v

        self.bb_token = bb_auth_token
        self._set_cookie_safe("BBAUTHTOKEN", bb_auth_token)
        self._set_cookie_safe("_bb_source", "app")

        if m_id:
            self.m_id = _maybe_decode(m_id)
            self._set_cookie_safe("_bb_mid", self.m_id)
        if bb_visitor_id:
            self.visitor_id = _maybe_decode(bb_visitor_id)
            self._set_cookie_safe("_bb_vid", self.visitor_id)

        if not self.m_id or not self.visitor_id:
            try:
                parts = bb_auth_token.split(".")
                if len(parts) >= 2:
                    payload_b64 = parts[1] + "=" * ((4 - len(parts[1]) % 4) % 4)
                    payload = json.loads(
                        base64.urlsafe_b64decode(payload_b64).decode("utf-8")
                    )
                    if not self.m_id and payload.get("mid"):
                        self.m_id = str(payload["mid"])
                        self._set_cookie_safe("_bb_mid", self.m_id)
                    if not self.visitor_id and payload.get("vid"):
                        self.visitor_id = str(payload["vid"])
                        self._set_cookie_safe("_bb_vid", self.visitor_id)
            except Exception:
                pass

    def _set_cookie_safe(self, name, value):
        try:
            if name in self.session.cookies:
                del self.session.cookies[name]
        except Exception:
            pass
        if value is not None:
            self.session.cookies.set(name, value)

    def _update_cookies(self, response):
        if hasattr(response, 'cookies'):
            try:
                for key, value in response.cookies.items():
                    self._set_cookie_safe(key, value)
                    if key == 'csurftoken':
                        self.csurftoken = value
            except Exception:
                pass

    def _request_with_retry(self, method, url, **kwargs):
        response = None
        for attempt in range(3):
            if attempt > 0:
                time.sleep(2)
            try:
                fn = getattr(self.session, method.lower())
                response = fn(url, **kwargs)
                if response.status_code != 429:
                    return response
            except Exception:
                if attempt == 2:
                    raise
        return response

